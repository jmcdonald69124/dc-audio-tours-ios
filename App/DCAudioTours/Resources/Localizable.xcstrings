    "The first stop of every tour is free. Unlock %@ to hear every stop.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Stopp jeder Tour ist kostenlos. Schalten Sie %@ frei, um alle Stopps zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first stop of every tour is free. Unlock %@ to hear every stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera parada de cada tour es gratis. Desbloquea %@ para escuchar todas las paradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier arrêt de chaque visite est gratuit. Débloquez %@ pour écouter tous les arrêts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ツアーの最初のストップは無料です。%@をアンロックすると、すべてのストップを聴けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 투어의 첫 정류장은 무료입니다. %@을(를) 잠금 해제하면 모든 정류장을 들을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira parada de cada tour é grátis. Desbloqueie %@ para ouvir todas as paradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个导览的第一站免费。解锁“%@”即可收听全部站点。"
          }
        }
      }
    },
