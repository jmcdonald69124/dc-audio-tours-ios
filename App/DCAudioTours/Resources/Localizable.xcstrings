          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        }
      }
    },
    "Most visitors start with one walkable area or one themed story. You can always open the full catalog after that.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Besucher beginnen mit einem Viertel zu Fuß oder mit einer Themen-Geschichte. Danach können Sie jederzeit den gesamten Katalog öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most visitors start with one walkable area or one themed story. You can always open the full catalog after that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los visitantes empieza con una zona para recorrer a pie o con una historia temática. Después siempre puedes abrir el catálogo completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des visiteurs commencent par un quartier à parcourir à pied ou par une histoire thématique. Vous pourrez ensuite ouvrir tout le catalogue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの方は、歩いて回れる1つのエリアか、1つのテーマ別ストーリーから始めます。そのあとで全カタログをいつでも開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 방문객은 걸어서 둘러볼 수 있는 한 지역이나 하나의 테마 이야기로 시작합니다. 그 후에 전체 카탈로그를 언제든 열어볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria dos visitantes começa com uma região para explorar a pé ou com uma história temática. Depois, você pode abrir o catálogo completo quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数游客会从一个适合步行的街区或一个主题故事开始。之后您随时可以打开完整目录。"
          }
        }
      }
    },
