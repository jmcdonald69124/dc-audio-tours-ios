    "Walking directions aren't available right now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegbeschreibungen zu Fuß sind derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking directions aren't available right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las indicaciones a pie no están disponibles ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les itinéraires à pied ne sont pas disponibles pour le moment."
          }
        },
        "ja": {
          "stringUnit": {
