    "Walking times are estimates; each stop shows a live route from Apple Maps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehzeiten sind Schätzungen; bei jedem Stopp wird eine aktuelle Route aus Karten angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking times are estimates; each stop shows a live route from Apple Maps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos a pie son estimaciones; cada parada muestra una ruta actualizada de Mapas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les durées de marche sont estimées ; chaque arrêt affiche un itinéraire en direct de Plans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "徒歩時間は目安です。各ストップではマップのリアルタイムのルートを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도보 시간은 예상치이며, 각 정류장에서 지도의 실시간 경로를 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos a pé são estimativas; cada parada mostra uma rota em tempo real do Mapas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行时间仅为估算；每个站点都会显示“地图”提供的实时路线。"
          }
        }
      }
    },
    "Washington DC self-guided audio tours, walkable and accessible by Metro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstgeführte Audio-Touren durch Washington DC – zu Fuß erkundbar und mit der Metro erreichbar"
          }
        },
        "en": {
