    "Start at a Metro stop, listen as you walk, and explore museums, monuments, food halls, and hidden neighborhoods at your own pace.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie an einer Metro-Station, hören Sie beim Laufen zu und entdecken Sie Museen, Monumente, Markthallen und versteckte Viertel in Ihrem eigenen Tempo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at a Metro stop, listen as you walk, and explore museums, monuments, food halls, and hidden neighborhoods at your own pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience en una estación de Metro, escuche mientras camina y explore museos, monumentos, mercados y barrios escondidos a su propio ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à une station de métro, écoutez en marchant et découvrez musées, monuments, marchés et quartiers cachés à votre rythme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地下鉄駅から始めて、歩きながら音声を聞き、博物館、記念碑、フードホール、隠れた街並みを自分のペースで楽しめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로 역에서 시작해 걸으며 오디오를 듣고, 박물관, 기념물, 푸드홀, 숨겨진 동네를 내 속도로 둘러보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece em uma estação, ouça enquanto caminha e explore museus, monumentos, mercados e bairros escondidos no seu ritmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从地铁站出发，边走边听，按自己的节奏探索博物馆、纪念碑、美食广场和隐藏街区。"
          }
        }
      }
    },
